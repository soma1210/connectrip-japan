{
  "name": "connectrip-japan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:v1": "NEXT_PUBLIC_WEBSITE_V1_PREVIEW=1 WEBSITE_V1_PREVIEW_ROOT=1 next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "bun scripts/migrate.ts",
    "check:v1-guides": "NEXT_PUBLIC_WEBSITE_V1_PREVIEW=1 bun scripts/check-v1-guides.ts",
    "check:booking": "bun --no-env-file src/lib/booking-request/rules.test.ts && bun --no-env-file src/lib/booking-request/api.test.ts",
    "check:inquiries": "bun --no-env-file src/lib/notify/forms.test.ts && bun --no-env-file src/lib/inquiries/db.test.ts && bun --no-env-file src/lib/inquiries/admin.test.ts && bun --no-env-file src/lib/admin/session.test.ts",
    "check:site": "bun --no-env-file src/website-v1/booking/tourBookingRequest.test.ts && bun --no-env-file src/website-v1/content/privacyPolicy.test.ts && bun --no-env-file src/website-v1/seoGuard.test.ts",
    "check:indexnow": "bun --no-env-file scripts/indexnow/indexnow.test.ts",
    "indexnow:dry-run": "bun --no-env-file scripts/indexnow/run.ts --mode dry-run",
    "test:unit": "bun run check:booking && bun run check:inquiries && bun run check:site && bun run check:indexnow"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.9.5",
    "@next/third-parties": "^16.3.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/postgres": "^0.10.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "sharp",
    "unrs-resolver"
  ]
}
