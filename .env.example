# SMTP settings used to email contact and reservation form submissions
# (src/lib/mailer.ts). Leave these unset during local development —
# submissions will be logged to the console instead of sent. Copy this file
# to .env.local and fill in real values to enable delivery.
#
# Using Resend's SMTP relay (current production setup):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<Resend API key, from resend.com/api-keys>
# Before sending as @connectripjapan.com, the domain must be verified in the
# provider (Resend: DKIM TXT `resend._domainkey`, and the `send` subdomain MX/TXT).
# 2026-11-16 (later check): public DNS now has the DKIM TXT `resend._domainkey`
# and `send` subdomain MX/TXT records; the root MX is Microsoft 365. Whether the
# domain shows as verified in Resend has not been checked yet; confirm it in the
# Resend dashboard before the first send.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER if unset.
SMTP_FROM=
# Where contact and reservation submissions are delivered.
CONTACT_TO_EMAIL=contact@connectripjapan.com
# Website v1 forms (booking requests, Inquiry form) staff email, 2026-11-16.
# Sender on the verified domain (never the customer's address; the customer goes in Reply-To).
NOTIFY_FROM="Connectrip Japan <notifications@connectripjapan.com>"
# Optional, defaults to CONTACT_TO_EMAIL, then contact@connectripjapan.com.
NOTIFY_TO=

# --- Admin panel (/admin) — Gallery, Blog and Reviews content management ---
#
# 1. In the Vercel dashboard, open this project's Storage tab and connect a
#    Postgres database and a Blob store. Vercel injects POSTGRES_URL and
#    BLOB_READ_WRITE_TOKEN automatically in production — you don't set them
#    by hand there.
# 2. For local development, run `vercel env pull .env.local` to copy those
#    values down, then run `bun run db:init` once to create the tables.
# 3. Set your own admin password below (any string). Without it, /admin is
#    disabled and the public site falls back to its built-in Gallery/Blog/
#    Reviews content.

#
# Inquiry management (Phase 1, 2026-11-16): POSTGRES_URL is also the system of
# record for the Contact / Booking Request forms (tables inquiries,
# inquiry_events, notification_outbox) and for admin sessions. Without it the
# forms stay in mock mode, the form APIs answer 503 and, in production,
# /admin refuses to log in. POSTGRES_URL must be the *pooled* connection string.
# Create the tables with `bun run db:migrate` (dry run) and
# `bun run db:migrate -- --apply` — run against a test / branch database first.
# POSTGRES_URL_NON_POOLING (direct connection) is used by the migration script when set.
# ADMIN_PASSWORD: use a long random value (16+ characters). Changing it ends every admin session.

POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=

# Notification retry job (Phase 2): POST /api/internal/notifications/retry with
# "Authorization: Bearer <CRON_SECRET>", called every 10 minutes by
# netlify/functions/notification-retry.mts. Random, 32+ characters. Unset = job disabled (404).
CRON_SECRET=

# Local end-to-end tests only (ignored in production builds): route the Neon
# driver through a local WebSocket proxy, e.g. 127.0.0.1:54330/v1. Never set in production.
NEON_LOCAL_WS_PROXY=

# --- Google Tag Manager ---
# Container ID from Google Tag Manager (Admin > Container Settings), looks
# like GTM-XXXXXXX. Leave unset to disable GTM entirely.
# GA4 is NOT loaded separately in code — it's configured as a "GA4 Configuration"
# tag inside this GTM container (GA4 Measurement ID: G-RBKEJSYW15), firing on
# All Pages. Configure/verify that in the GTM web UI, not in this repo.
NEXT_PUBLIC_GTM_ID=

# --- Booking Apps Script (Google Sheets) — no longer used by the form APIs ---
# Since Phase 1 (2026-11-16) the forms store into Postgres. These settings are
# kept for the existing Sheets data and tooling only.
# URL: https://script.google.com/macros/s/<deployment-id>/exec
# Use the same server-only secret as the booking Apps Script (at least 32 characters).
BOOKING_GAS_URL=
BOOKING_GAS_SECRET=
