# SMTP settings used to email reservation form submissions (src/lib/mailer.ts).
# Leave these unset during local development — submissions will be logged to
# the console instead of sent. Copy this file to .env.local and fill in real
# values to enable delivery.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER if unset.
SMTP_FROM=
# Where reservation submissions are delivered.
RESERVATION_TO_EMAIL=contact@connectripjapan.com
