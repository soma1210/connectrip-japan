# SMTP settings used to email contact and reservation form submissions
# (src/lib/mailer.ts). Leave these unset during local development —
# submissions will be logged to the console instead of sent. Copy this file
# to .env.local and fill in real values to enable delivery.
#
# Using Resend's SMTP relay (current production setup):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<Resend API key, from resend.com/api-keys>
# The connectripjapan.com sending domain is already verified in Resend
# (SPF/DKIM), so SMTP_FROM can be any @connectripjapan.com address.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER if unset.
SMTP_FROM=
# Where contact and reservation submissions are delivered.
CONTACT_TO_EMAIL=contact@connectripjapan.com

# --- Admin panel (/admin) — Gallery, Blog and Reviews content management ---
#
# 1. In the Vercel dashboard, open this project's Storage tab and connect a
#    Postgres database and a Blob store. Vercel injects POSTGRES_URL and
#    BLOB_READ_WRITE_TOKEN automatically in production — you don't set them
#    by hand there.
# 2. For local development, run `vercel env pull .env.local` to copy those
#    values down, then run `bun run db:init` once to create the tables.
# 3. Sign-in is "Sign in with Google", limited to the two addresses below
#    (src/admin/session.ts, src/admin/google-login.ts). Its OAuth client is
#    separate from the Sheets and Calendar ones and asks for openid + email only.
#    Authorized redirect URI: <site>/admin/auth/google/callback for each site
#    (e.g. http://localhost:3000/... and the production URL).

POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
# Random string of 32+ characters that signs the session cookie, e.g.
# `openssl rand -hex 32`. Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# Optional: fixed site URL for the redirect URI (e.g. https://connectripjapan.com).
# Unset, the URL the request came in on is used.
ADMIN_AUTH_URL=
# Local development only (`next dev`): sign in without Google. Ignored by
# production builds, Netlify deploy previews included.
ADMIN_DEV_PASSWORD=

# --- Google Tag Manager ---
# Container ID from Google Tag Manager (Admin > Container Settings), looks
# like GTM-XXXXXXX. Leave unset to disable GTM entirely.
# GA4 is NOT loaded separately in code — it's configured as a "GA4 Configuration"
# tag inside this GTM container (GA4 Measurement ID: G-RBKEJSYW15), firing on
# All Pages. Configure/verify that in the GTM web UI, not in this repo.
NEXT_PUBLIC_GTM_ID=

# --- Guide Admin (/admin/guide-sheet) — Google Form applications, read only ---
# Reads the "Connectrip Guide Applications" spreadsheet with an OAuth refresh
# token limited to spreadsheets.readonly (src/lib/google-sheets.ts). Get the
# refresh token with scripts/google-sheets-auth.mjs. Without these, local
# development shows sample rows and production shows an error.

GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
GUIDE_SHEET_SPREADSHEET_ID=
