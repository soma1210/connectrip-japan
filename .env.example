# SMTP settings used to email contact and reservation form submissions
# (src/lib/mailer.ts). Leave these unset during local development —
# submissions will be logged to the console instead of sent. Copy this file
# to .env.local and fill in real values to enable delivery.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER if unset.
SMTP_FROM=
# Where contact and reservation submissions are delivered.
CONTACT_TO_EMAIL=contact@connectripjapan.com

# --- Admin panel (/admin) — Gallery, Blog and Reviews content management ---
#
# 1. In the Vercel dashboard, open this project's Storage tab and connect a
#    Postgres database and a Blob store. Vercel injects POSTGRES_URL and
#    BLOB_READ_WRITE_TOKEN automatically in production — you don't set them
#    by hand there.
# 2. For local development, run `vercel env pull .env.local` to copy those
#    values down, then run `bun run db:init` once to create the tables.
# 3. Set your own admin password below (any string). Without it, /admin is
#    disabled and the public site falls back to its built-in Gallery/Blog/
#    Reviews content.

POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
ADMIN_PASSWORD=

# --- Google Tag Manager ---
# Container ID from Google Tag Manager (Admin > Container Settings), looks
# like GTM-XXXXXXX. Leave unset to disable GTM entirely.
# GA4 is NOT loaded separately in code — it's configured as a "GA4 Configuration"
# tag inside this GTM container (GA4 Measurement ID: G-RBKEJSYW15), firing on
# All Pages. Configure/verify that in the GTM web UI, not in this repo.
NEXT_PUBLIC_GTM_ID=
